# syntax=docker/dockerfile:1.7
# Catalog scanner. Build context: repo root.
#
# Designed for one-shot execution: a k8s CronJob (or `docker compose run scanner`)
# starts the container, it scans, it exits. `--init` is idempotent so the same
# command works for first run and steady state. `--prune` soft-deletes samples
# whose folders have disappeared from disk, so deletions propagate to the site
# (guarded by the 0.5 prune safety floor; raise it for large bulk migrations).

FROM ghcr.io/prefix-dev/pixi:0.73.0-bookworm-slim AS base
WORKDIR /app

# git is needed to fetch the mrc-ng-server git dependency (provides the
# mrc-pyramid CLI the scan's precompute step runs) during resolution; the slim
# pixi base doesn't ship it. Only the build stage needs it — the runtime stage
# copies the resolved .pixi tree.
FROM base AS deps
RUN apt-get update && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*
COPY pixi.lock pyproject.toml ./
RUN pixi install --locked -e catalog

FROM base AS runtime
# OVITO is a pip wheel (PySide6/Qt6), which dynamically links system libraries
# the pixi slim base doesn't ship. Even with QT_QPA_PLATFORM=offscreen the Qt6
# GUI stack dlopens glib, GL/EGL, dbus and xkbcommon on import — without these
# the render subprocess dies with "libglib-2.0.so.0: cannot open shared object
# file". Runtime-only; the build stage resolves wheels without them.
RUN apt-get update && apt-get install -y --no-install-recommends \
    libglib2.0-0 libgl1 libopengl0 libegl1 libdbus-1-3 libxkbcommon0 \
    libfontconfig1 libgssapi-krb5-2 \
    && rm -rf /var/lib/apt/lists/*
# libopengl0 (libOpenGL.so.0, Qt6 GLVND) and libgssapi-krb5-2 (QtNetwork) are the
# only remaining libs `ldd` on the OVITO plugins reports missing; the two GPU libs
# it also lists (libcuda, libnvidia-ml) are optional — TachyonRenderer is CPU-only.
COPY --from=deps /app/.pixi /app/.pixi
# Packages live under src/ (src layout); pixi activation sets PYTHONPATH=src.
COPY pixi.lock pyproject.toml ./
COPY src ./src

# OpenShift runs the pod as an arbitrary non-root UID that belongs to gid 0.
# When a one-shot pixi task exits, pixi writes a task cache under
# /app/.pixi/task-cache-v0/, so /app must be writable by gid 0 or the run fails
# with "Permission denied (os error 13)" *after* the scan succeeds. chgrp is a
# no-op (the COPY'd tree is already gid 0) but makes the intent explicit;
# `chmod g=u` grants the group the same access as the owner.
RUN chgrp -R 0 /app && chmod -R g=u /app

# MRCNG_CACHE_ROOT is the shared Neuroglancer pyramid cache. When set, the scan
# runs `mrc-pyramid build` into it after cataloguing (catalog/cli.py
# `_run_precompute`); mrc-ng-server reads the same path. Must match the
# mrc-cache mountPath here and MRCNG_CACHE_ROOT in the mrc-ng-server ConfigMap.
ENV CATALOG_DATA_ROOT=/groups/cryoet/cryoet/data \
    CATALOG_DB_URL=sqlite:////db/catalog.db \
    CATALOG_THUMBNAIL_DIR=/thumbnails \
    CATALOG_MD_PREVIEW_DIR=/md-previews \
    MRCNG_CACHE_ROOT=/cache

CMD ["pixi", "run", "-e", "catalog", "scan", "--init", "--prune"]
