# syntax=docker/dockerfile:1.7
# FastAPI read-only catalog API. Build context: repo root.
#
# Layer order is tuned for cache reuse: pixi.lock changes rarely, source
# changes often. Keep the lockfile copy in its own early step.

FROM ghcr.io/prefix-dev/pixi:0.73.0-bookworm-slim AS base
WORKDIR /app

# Resolve and materialize only the `api` environment from pixi.lock.
# git is needed to fetch the mrc-ng-server git dependency (provides the
# mrc-pyramid CLI) during resolution; the slim pixi base doesn't ship it. Only
# the build stage needs it — the runtime stage copies the resolved .pixi tree.
FROM base AS deps
RUN apt-get update && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*
COPY pixi.lock pyproject.toml ./
RUN pixi install --locked -e api

FROM base AS runtime
COPY --from=deps /app/.pixi /app/.pixi
# Packages live under src/ (src layout). pixi's activation sets PYTHONPATH=src
# (relative to WORKDIR /app), so catalog/schema import cleanly.
COPY pixi.lock pyproject.toml ./
COPY src ./src

# OpenShift runs the pod as an arbitrary non-root UID in gid 0. The long-running
# uvicorn task never exits so it doesn't currently hit pixi's post-task cache
# write under /app/.pixi, but one-shot tasks (e.g. `pixi run -e api migrate` as
# an init container) would fail with "Permission denied (os error 13)". Make
# /app writable by gid 0 to keep the image robust and consistent with the
# scanner image. See Dockerfile.scanner for the full explanation.
RUN chgrp -R 0 /app && chmod -R g=u /app

# CATALOG_DATA_ROOT must match the path scanner used when writing the DB —
# the API resolves DB-recorded paths against this and rejects anything outside.
ENV CATALOG_DATA_ROOT=/groups/cryoet/cryoet/data \
    CATALOG_DB_URL=sqlite:////db/catalog.db \
    CORS_ORIGINS=http://localhost:3000

EXPOSE 8000
CMD ["pixi", "run", "-e", "api", "uvicorn", "catalog.api.main:app", \
     "--host", "0.0.0.0", "--port", "8000"]
