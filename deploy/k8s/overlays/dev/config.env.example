# Copy to config.env and edit. Consumed by the api, scanner and mrc-ng-server
# via envFrom. config.env is gitignored — never commit real values.
#
# The production overlay's config.env.example is the annotated reference for
# every key below (what it does, what breaks if it is wrong). Only the 
# dev-specific reasoning is repeated here.
#
# All FILESYSTEM PATHS below are deliberately identical to production: they are
# in-container mount paths from the base manifests, not host paths, so there is
# nothing environment-specific about them. Changing one here without changing
# the matching mountPath silently breaks the deployment. Only the HOSTNAMES
# differ.

# Root of the data tree. Dev mounts the SAME read-only NFS export as production
# (via its own PV — see the overlay's kustomization.yaml), so dev renders real
# data. Every mount of it is flagged readOnly, so dev cannot corrupt it.
# MUST match the catalog-data mountPath in deploy/k8s/base/api.yaml,
# deploy/k8s/base/scanner.yaml and deploy/k8s/base/mrc-ng-server.yaml.
CATALOG_DATA_ROOT=/groups/cryoet/cryoet/data

# SQLite catalog DB, on dev's own catalog-db volume (mounted at /db). Separate
# from production's — dev's nightly scanner rebuilds this copy, and it is safe
# to delete and rescan when a schema change breaks it.
CATALOG_DB_URL=sqlite:////db/catalog.db

# Thumbnail PNGs (the thumbnails volume). The API refuses to start if missing.
CATALOG_THUMBNAIL_DIR=/thumbnails

# OVITO MD-run preview PNGs (the md-previews volume). Optional: a missing dir
# does not block API startup, it just disables the /api/md-previews route.
CATALOG_MD_PREVIEW_DIR=/md-previews

# Browser origins the API accepts. Must be the dev Route host, matching the
# spec.host patch in this overlay's kustomization.yaml.
CORS_ORIGINS=https://ai-cryoet-dev.int.janelia.org

# ── mrc-ng-server integration (stateless tomogram viewer) ────────────────────
# The mrc-ng-server pods read the MRCNG_* keys from this same ConfigMap, so the
# cache path and data root have one source of truth shared with the scanner.

# MUST equal CATALOG_DATA_ROOT — the API builds precomputed:// URLs from each
# tomogram's mrc_path relative to this root.
MRCNG_SOURCE_ROOT=/groups/cryoet/cryoet/data

# Shared Neuroglancer pyramid cache (the mrc-cache volume). The scanner runs
# `mrc-pyramid build` into it after each nightly scan; mrc-ng-server reads it.
MRCNG_CACHE_ROOT=/cache

# Browser origins mrc-ng-server accepts chunk requests from (CORS). The
# Neuroglancer viewer app is hosted by Fileglancer and fetches cross-origin.
MRCNG_CORS_ORIGINS=https://fileglancer.int.janelia.org

# Base URL of the mrc-ng-server data service from the BROWSER's perspective.
# Served via nginx's /mrc-ng-server/ location on the dev Route host, so it needs
# no host of its own. HTTPS is required — an HTTP source inside the HTTPS viewer
# is blocked as mixed content.
MRCNG_BASE_URL=https://ai-cryoet-dev.int.janelia.org/mrc-ng-server/data