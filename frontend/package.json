{
    "name": "tanstack-start-example-material-ui",
    "private": true,
    "sideEffects": false,
    "type": "module",
    "scripts": {
        "prepare": "lefthook install || true",
        "dev": "vite dev",
        "build": "vite build && tsc --noEmit",
        "preview": "vite preview",
        "test": "vitest run",
        "start": "srvx --prod -s ../client dist/server/server.js",
        "gen:types": "openapi-typescript openapi.json -o src/types.gen.ts",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format:check": "prettier \"**/*{.ts,.tsx,.js,.jsx,.css,.json,.md}\" \"!package-lock.json\" --check",
        "format": "prettier --list-different --write \"**/*{.ts,.tsx,.js,.jsx,.json,.md}\" \"!package-lock.json\""
    },
    "dependencies": {
        "@emotion/cache": "11.14.0",
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.0",
        "@fontsource-variable/roboto": "5.2.5",
        "@mui/icons-material": "^6.5.0",
        "@mui/material": "^6.5.0",
        "@mui/x-data-grid": "^7.29.13",
        "@mui/x-date-pickers": "^7.29.4",
        "@mui/x-tree-view": "^7.29.10",
        "@tanstack/react-query": "^5.62.0",
        "@tanstack/react-query-devtools": "^5.62.0",
        "@tanstack/react-router": "^1.169.2",
        "@tanstack/react-router-devtools": "^1.166.13",
        "@tanstack/react-start": "^1.167.65",
        "cron-parser": "^5.6.1",
        "cronstrue": "^3.21.0",
        "material-react-table": "^3.2.1",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "zod": "^3.24.2"
    },
    "devDependencies": {
        "@eslint/js": "^9.26.0",
        "@eslint/json": "^0.12.0",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.1",
        "@types/node": "^22.5.4",
        "@types/react": "^19.0.8",
        "@types/react-dom": "^19.0.3",
        "@vitejs/plugin-react": "^6.0.1",
        "@vitest/ui": "^4.1.8",
        "eslint": "^9.26.0",
        "eslint-config-prettier": "^10.1.5",
        "eslint-plugin-prettier": "^5.4.0",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^5.2.0",
        "globals": "^15.15.0",
        "jsdom": "^30.0.1",
        "lefthook": "^1.12.2",
        "openapi-typescript": "^7.4.1",
        "prettier": "3.8.3",
        "typescript": "^6.0.2",
        "typescript-eslint": "^8.32.1",
        "vite": "^8.2.1",
        "vitest": "^4.1.8"
    },
    "overrides": {
        "openapi-typescript": {
            "typescript": "$typescript"
        }
    }
}
