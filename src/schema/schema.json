          },
          "title": "Tilt Series",
          "type": "array"
        },
        "reconstruction_alignment": {
          "items": {
            "$ref": "#/$defs/ReconstructionAlignment"
          },
          "title": "Reconstruction Alignment",
          "type": "array"
        }
