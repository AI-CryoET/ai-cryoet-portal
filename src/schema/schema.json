    "ReconstructionAlignment": {
      "additionalProperties": true,
      "description": "One 3D-alignment group within an acquisition (composite-PK child of\nAcquisition).\n\nComposite primary key: ``(sample_id, acquisition_id, reconstruction_alignment_id)``.\nThe group is a researcher-authored folder under ``Reconstructions/`` \u2014\n``reconstruction_alignment_id`` is its directory name (accepted as the\nTOML ``id`` alias). It does NOT have to match any ``tilt_series_id``: a\ntomogram's tilt-series lineage is recorded separately on\n``RawTomogram.derived_from``. All non-PK fields are optional so a group\ncan be ingested before disk enrichment runs.",
      "properties": {
        "sample_id": {
          "title": "Sample Id",
          "type": "string"
        },
        "acquisition_id": {
          "title": "Acquisition Id",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "renamed_from": {
          "title": "Renamed From",
          "type": "string"
        },
        "alignment_software": {
          "title": "Alignment Software",
          "type": "string"
        },
        "alignment_method": {
          "title": "Alignment Method",
          "type": "string"
        },
        "alignment_files": {
          "items": {
            "type": "string"
          },
          "title": "Alignment Files",
          "type": "array"
        },
        "mtime": {
          "title": "Mtime",
          "type": "number"
        }
      },
      "title": "ReconstructionAlignment",
      "type": "object"
    },
    "ReconstructionFile": {
      "additionalProperties": true,
      "description": "Parsed contents of one Reconstructions/{id}/reconstruction.toml.\n\n``reconstruction_alignment_id`` is the folder name (path-injected by the\nloader, not authored). Tomogram/annotation ids are the file stems in this\nfolder. Cross-file references (raw_tomogram.derived_from -> a tilt_series in\nacquisition.toml; post_processed_tomogram.derived_from -> a tomogram in this\nor another group) are reconciled by the loader after aggregation, not here.",
      "properties": {
        "reconstruction_alignment": {
          "$ref": "#/$defs/ReconstructionAlignment"
        },
        "raw_tomogram": {
          "items": {
            "$ref": "#/$defs/RawTomogram"
