    "TiltSeries": {
      "additionalProperties": true,
      "description": "One tilt series within an acquisition (composite-PK child of Acquisition).\n\nComposite primary key: ``(sample_id, acquisition_id, tilt_series_id)``.\nThe tilt series is a researcher-authored folder under ``TiltSeries/`` \u2014\n``tilt_series_id`` is its directory name (accepted as the TOML ``id``\nalias). A tilt series may be stored raw/unaligned or already geometrically\ntransformed (``is_aligned``); alignment is folded in as transformation\nparameters rather than a separate entity. The MDOC-derived tilt geometry\nlives on :class:`Acquisition` (one acquisition tilt scheme, shared by all\nits tilt series). All non-PK fields are optional so a tilt series can be\ningested before disk enrichment runs.",
      "properties": {
        "sample_id": {
          "title": "Sample Id",
          "type": "string"
        },
        "acquisition_id": {
          "title": "Acquisition Id",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "renamed_from": {
          "title": "Renamed From",
          "type": "string"
        },
        "derived_from": {
          "title": "Derived From",
          "type": "string"
        },
        "is_aligned": {
          "title": "Is Aligned",
          "type": "boolean"
        },
        "alignment_software": {
          "title": "Alignment Software",
          "type": "string"
        },
        "alignment_method": {
          "title": "Alignment Method",
          "type": "string"
        },
        "st_path": {
          "title": "St Path",
          "type": "string"
        },
        "zarr_path": {
          "title": "Zarr Path",
          "type": "string"
        },
        "alignment_files": {
          "items": {
            "type": "string"
          },
          "title": "Alignment Files",
          "type": "array"
        },
        "mtime": {
          "title": "Mtime",
          "type": "number"
        }
      },
      "title": "TiltSeries",
      "type": "object"
    }
  },
  "additionalProperties": true,
  "description": "Merged sample.toml + every acquisition.toml under the sample directory.\n\n`acquisitions` is keyed by acquisition directory name (path-injected by the\nvalidator, not authored in the TOML).",
